<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PaymentPageController">
   <content>
      <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white;">
         <padding>
            <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
         </padding>
         <children>
            <Label text="Payment &amp; Invoicing" textFill="#1e1e1e">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <HBox spacing="20.0">
               <children>
                  <VBox spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label text="Simulate Payment">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="amountField" promptText="Amount (e.g. 150.00)" />
                        <TextField fx:id="currencyField" promptText="Currency (USD, EUR)" text="USD" />
                        <TextField fx:id="promoCodeField" promptText="Promo Code (Optional)" />
                        <Button mnemonicParsing="false" onAction="#handleProcessPayment" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="Process Payment">
                           <graphic>
                              <FontIcon iconLiteral="mdi-credit-card" iconColor="WHITE" />
                           </graphic>
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleApplyPromo" prefHeight="30.0" text="Apply Promo Code" />
                        <Label fx:id="statusLabel" textFill="#2196f3" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label text="Payment History">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <ListView fx:id="paymentListView" prefHeight="300.0" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleGenerateInvoice" text="Generate Invoice">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi-file-document" />
                                 </graphic>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#handleRefund" text="Request Refund">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi-undo" />
                                 </graphic>
                              </Button>
                           </children>
                        </HBox>
                        <Label fx:id="historyStatusLabel" textFill="#2196f3" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
