<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" stylesheets="@../style/PaymentPage.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PaymentPageController">
   <content>
      <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-background-color: #f4f6f9; -fx-padding: 40;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Button onAction="#goBack" styleClass="secondary-button" text="Back">
                     <graphic>
                        <FontIcon iconLiteral="mdi-arrow-left" iconSize="20"/>
                     </graphic>
                  </Button>
                  <Label styleClass="header-label" text="Payment &amp; Services" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <!-- Payment Simulation Card -->
                  <VBox spacing="20.0" styleClass="payment-card" HBox.hgrow="ALWAYS" maxWidth="500">
                     <children>
                        <Label styleClass="section-header" text="Make a Payment" />
                        
                        <VBox spacing="5">
                           <Label text="Amount" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                           <TextField fx:id="amountField" promptText="0.00" />
                        </VBox>
                        
                        <VBox spacing="5">
                           <Label text="Currency" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                           <ComboBox fx:id="currencyComboBox" promptText="Select Currency" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        
                        <VBox spacing="5">
                           <Label text="Promo Code" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                           <HBox spacing="10" alignment="CENTER_LEFT">
                              <TextField fx:id="promoCodeField" promptText="Enter Code" HBox.hgrow="ALWAYS"/>
                              <Button onAction="#handleApplyPromo" styleClass="secondary-button" text="Apply"/>
                           </HBox>
                        </VBox>

                        <Button onAction="#handleProcessPayment" prefHeight="50.0" maxWidth="1.7976931348623157E308" styleClass="premium-button" text="PROCESS PAYMENT">
                           <graphic>
                              <FontIcon iconLiteral="mdi-credit-card" iconColor="WHITE" iconSize="18"/>
                           </graphic>
                        </Button>
                        
                        <Label fx:id="statusLabel" styleClass="status-label" wrapText="true" alignment="CENTER" maxWidth="1.7976931348623157E308"/>
                     </children>
                  </VBox>

                  <!-- History & Services Card -->
                  <VBox spacing="20.0" styleClass="payment-card" HBox.hgrow="ALWAYS" maxWidth="500">
                     <children>
                        <Label styleClass="section-header" text="History &amp; Actions" />
                        
                        <ListView fx:id="paymentListView" prefHeight="250.0" />
                        
                        <HBox spacing="15.0" alignment="CENTER">
                           <children>
                              <Button onAction="#handleGenerateInvoice" styleClass="secondary-button" text="Get Invoice" prefWidth="150" prefHeight="40">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi-file-document" iconSize="16"/>
                                 </graphic>
                              </Button>
                              <Button onAction="#handleRefund" styleClass="secondary-button" text="Refund" prefWidth="150" prefHeight="40">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi-undo" iconSize="16"/>
                                 </graphic>
                              </Button>
                           </children>
                        </HBox>
                        
                        <Label fx:id="historyStatusLabel" styleClass="status-label" wrapText="true" alignment="CENTER" maxWidth="1.7976931348623157E308"/>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
