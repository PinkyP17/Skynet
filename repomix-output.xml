package com.skynet.admin.osgi;

import org.osgi.framework.BundleActivator;
import org.osgi.framework.BundleContext;
import org.osgi.framework.ServiceRegistration;
import com.skynet.admin.service.AdminService;

public class Activator implements BundleActivator {

    private ServiceRegistration<?> registration;

    @Override
    public void start(BundleContext context) throws Exception {
        System.out.println("-------------------------------------------");
        System.out.println("🚀 Skynet Admin OSGi Bundle is starting...");
        System.out.println("-------------------------------------------");

        // Register the AdminService into the OSGi Service Registry
        // This allows other bundles to find and use your admin logic
        AdminService adminService = new AdminService();
        registration = context.registerService(AdminService.class.getName(), adminService, null);
        
        System.out.println("✅ AdminService registered successfully in OSGi registry.");
    }

    @Override
    public void stop(BundleContext context) throws Exception {
        System.out.println("-------------------------------------------");
        System.out.println("🛑 Skynet Admin OSGi Bundle is stopping...");
        System.out.println("-------------------------------------------");
        
        // Unregister the service when the bundle stops
        if (registration != null) {
            registration.unregister();
        }
    }
}
