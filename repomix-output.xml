								</PROJECT_VERSION>
								<PROJECT_NAME>
									${project.build.finalName}
								</PROJECT_NAME>
								<MAIN_CLASS>${main.class}</MAIN_CLASS>
							</environmentVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>

</project>
